# Legislation Explorer environment variables
# Copy to .env and fill in real values
# Operator token: full access to the API and MCP, bypasses content gating.
# Leave empty unless needed; if set, use a long random value (e.g. openssl rand -hex 32).
LEGISLATION_BEARER_TOKEN=
ALLOWED_ORIGINS=https://lawkitty.app,http://localhost:5173,http://localhost:3000

# Public base URL and auth
# APP_BASE_URL=
# SESSION_SECRET=
# ADMIN_EMAILS=            # comma-separated; empty = nobody is admin
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=

# Extra MCP hosts/origins for non-prod deployments (comma-separated)
# MCP_EXTRA_ALLOWED_HOSTS=
# MCP_EXTRA_ALLOWED_ORIGINS=
# VITE_ALLOWED_HOSTS=      # Vite dev server allowed hosts (frontend)

# Optional paths (only needed for ingestion/ops scripts and the commentary bridge)
# LEGISLATION_EXPLORER_DIR=    # commentary bridge + corpus scripts
# LEGISLATION_STAGING_DIR=
# LEGISLATION_EXPLORER_DB_DIR=
# KNOWLEDGE_MCP_DIR=
# HERMES_DIR=                  # default ~/.hermes
# HERMES_ENV_FILE=             # default <repo>/.env
# BACKUP_DIR=                  # default ~/backups/legislation-explorer
# DB_BACKUP_DIR=               # default ~/backups/cadena-db
# LOG_DIR=                     # default ~/logs
# TABLE_REBUILD_OUT_DIR=       # default ~/table-rebuild-out
# EMBEDDINGS_BACKUP_DB=
# ASIC_CASES_DIR=
# ASIC_FINREG_DB=
# DEPLOY_HOST=                 # user@host for deploy/corpus-push scripts
# TELEGRAM_BOT_TOKEN=          # monitor/healthcheck.sh alerts
# TELEGRAM_CHAT_ID=
